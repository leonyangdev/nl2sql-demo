# 复制成 .env 后填入真实值：  copy .env.example .env
# .env 已在 .gitignore 里，不会被提交。
#
# 加载规则：默认 **.env 优先于进程环境变量**（NL2SQL_DOTENV_OVERRIDE=0 可改回
# 经典行为）。这样可以避免机器上残留的过期全局变量静默遮蔽项目配置。
# 占位符（如 sk-xxxx、<your-key>）会被自动忽略，不会覆盖真实值。
#
# 支持行内注释，但 # 前面必须有空格：KEY=value  # 备注
# 值本身含 # 时请用引号包起来：KEY="p#ss#word"

# ---------------------------------------------------------------------------
# 线上 Embedding（阿里云百炼 DashScope，OpenAI 兼容 /embeddings）
#   key 是唯一必填项；不配置则自动降级到 sentence-transformers / 本地哈希向量
# ---------------------------------------------------------------------------
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MaaS 专属端点示例；用公共端点就填 https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 向量模型
NL2SQL_EMBEDDING_MODEL=text-embedding-v4
# 期望维度；填 0 表示不传 dimensions，由服务端决定
NL2SQL_EMBEDDING_DIM=1024
# 单次请求最多几条文本（DashScope 建议 <= 10）
NL2SQL_EMBEDDING_BATCH_SIZE=10
# 用独立 key / 端点跑 embedding 时可以覆盖上面两项
# NL2SQL_EMBEDDING_API_KEY=
# NL2SQL_EMBEDDING_BASE_URL=

# ---------------------------------------------------------------------------
# 大模型（用于生成 SQL + 总结结果）
#   key 是唯一必填项；不配置则自动降级为本地规则模式
# ---------------------------------------------------------------------------
# deepseek（默认，自动探测到 key 即启用）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 也可以改用阿里云 DashScope（OpenAI 兼容模式）
# NL2SQL_LLM_PROVIDER=dashscope
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus

# ---------------------------------------------------------------------------
# 可选：在线链路开关
# ---------------------------------------------------------------------------
# SQL 生成方式：llm（默认）| rule（纯本地规则，不调用大模型）
# NL2SQL_SQL_GENERATOR=llm
# 是否让大模型总结查询结果：1 开 / 0 关
# NL2SQL_LLM_SUMMARY=1
# 生成 + 自我修正 SQL 的最大尝试次数
# NL2SQL_LLM_MAX_ATTEMPTS=3
# NL2SQL_LLM_TEMPERATURE=0
# NL2SQL_LLM_TIMEOUT=60

# ---------------------------------------------------------------------------
# 可选：Embedding 模式与向量库后端
# ---------------------------------------------------------------------------
# embedding：auto（默认，配了 key 就用线上，否则退回本地 hash）| dashscope | hash
# NL2SQL_EMBEDDER=auto

# 向量库：local（默认，SQLite 暴力检索）| milvus
# NL2SQL_VECTOR_STORE=local
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
